rules_version = '2';

// Firebase project used by genztrader-react (public site + embedded admin
// dashboard). Deploy/paste this whole file into Firebase console > Firestore
// Database > Rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin-ness lives on the requester's own users/{uid} doc as role:
    // 'admin'. To make someone an admin, open their doc in the Firebase
    // console and set role to "admin" (or use the dashboard's own "Make
    // admin" action once one admin already exists).
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Dev has the exact same Admin Dashboard access as admin (user approvals,
    // roles, tiers, permissions — everything below) with one difference: only
    // dev can see/edit the Videos panel (src/pages/AdminDashboard.jsx) —
    // admin can no longer write to /videos, see that match block below.
    function isDev() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'dev';
    }

    // Backward-compatible entitlement for approved users whose plan was set
    // from the Admin Dashboard before a subscription document was created.
    function hasPlanSignalAccess(userId) {
      let subscriptionPath = /databases/$(database)/documents/subscriptions/$(userId);
      let profile = get(/databases/$(database)/documents/users/$(userId)).data;
      let plan = profile.get('plan', '');
      let tier = profile.get('tier', '');
      let expiry = profile.get('subscriptionExpiresAt', null);
      return !exists(subscriptionPath)
        && profile.status == 'approved'
        && (plan in ['starter', 'pro', 'elite', 'vip'] || tier in ['starter', 'pro', 'elite', 'vip'])
        && (expiry == null || expiry > request.time.toMillis());
    }

    function hasActiveSubscription(userId) {
      let subscriptionPath = /databases/$(database)/documents/subscriptions/$(userId);
      let subscription = get(subscriptionPath).data;
      return (exists(subscriptionPath) && subscription.status == 'active' && subscription.expiryDate > request.time)
        || hasPlanSignalAccess(userId);
    }

    function hasFeature(userId, featureId) {
      let subscriptionPath = /databases/$(database)/documents/subscriptions/$(userId);
      let subscription = get(subscriptionPath).data;
      return (exists(subscriptionPath) && subscription.status == 'active' && subscription.expiryDate > request.time
        && featureId in subscription.features
        ) || (featureId == 'vip_signals' && hasPlanSignalAccess(userId));
    }

    match /users/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin() || isDev());

      // Signup: the client may create its own profile, but only as a
      // 'pending' / unverified / plain 'user' — it can't create itself
      // pre-approved or as an admin.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'status', 'role', 'tier', 'emailVerified', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.emailVerified == false
        && request.resource.data.role == 'user';

      // Users may update ordinary profile/progress fields only. Package,
      // payment, and expiry fields are exclusively written by the payment API.
      allow update: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerified', 'progress', 'photoURL'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.name == resource.data.name
          && request.resource.data.email == resource.data.email
          && request.resource.data.get('allowedLessons', null) == resource.data.get('allowedLessons', null)
          && request.resource.data.status == resource.data.status
          && request.resource.data.get('tier', null) == resource.data.get('tier', null)
          && request.resource.data.get('plan', null) == resource.data.get('plan', null)
          && request.resource.data.get('subscriptionExpiresAt', null) == resource.data.get('subscriptionExpiresAt', null)
          && request.resource.data.get('activeSubscriptionId', null) == resource.data.get('activeSubscriptionId', null))
        ||
        ((isAdmin() || isDev())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'role', 'tier', 'allowedLessons'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier']) || resource.data.status == 'approved'))
      );

      allow delete: if false;

      // Trading calendar entries — one doc per day, keyed "YYYY-MM-DD"
      // (src/data/journal.js). Private per-user: only the account itself
      // can ever read or write its own journal, no admin visibility since
      // this is personal trading data, not site content.
      match /journal/{dateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // FCM Web Push registration is private to the signed-in account and
      // only paid members (plus admin/dev) may register a device token.
      match /notificationTokens/{tokenId} {
        function canRegisterPush() {
          let profile = get(/databases/$(database)/documents/users/$(userId)).data;
          return request.auth != null && request.auth.uid == userId &&
            (profile.role in ['admin', 'dev'] || hasActiveSubscription(userId));
        }

        allow create, update: if canRegisterPush()
          && request.resource.data.keys().hasOnly(['token', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.updatedAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow read: if false;
      }
    }

    match /packages/{packageId} {
      allow read: if true;
      allow write: if isAdmin() || isDev();
    }

    match /payments/{paymentId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin() || isDev());
      allow create, update, delete: if false;
    }

    match /subscriptions/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId || isAdmin() || isDev());
      allow create, update, delete: if false;
    }

    // One-time OTP codes, keyed by uid. Only the owning (just-created) user
    // can read/write their own pending code.
    match /otps/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Login lockout counters, keyed by normalized email (src/data/auth.js) —
    // a failed sign-in has no uid to scope this to, so unlike everything
    // else here this has to be writable while signed out. Bounded so a
    // stranger can't abuse the open write to grief someone else's email
    // with a runaway or nonsensical lockout: count stays 0-4 and a lockout
    // can never be set more than ~2 minutes (plus a small clock-skew
    // allowance) out from now.
    match /loginAttempts/{email} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['count', 'lockedUntil', 'updatedAt'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 4
        && (request.resource.data.lockedUntil == null
          || request.resource.data.lockedUntil <= request.time.toMillis() + 130000);
    }

    // Video URL registry (Hero, lesson demo clips, etc.), keyed by a fixed
    // set of ids in src/data/videos.js — src/pages/*.jsx read this to know
    // which video to play (the files themselves live as GitHub Release
    // assets, not in Firebase at all). Public read (those URLs are already
    // public regardless); write is dev-only — admin does not get the Videos
    // panel in the Admin Dashboard, only dev does.
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isDev();
    }

    // New Product gold chart's saved custom indicators (src/data/customIndicator.js)
    // — one doc per named indicator {name, code, updatedAt}. Admin-only read
    // AND write, unlike `videos` above: this is a private admin tool, never
    // rendered for regular users, so there's no reason for anyone else to
    // even read it.
    match /customIndicators/{indicatorId} {
      allow read, write: if isAdmin();
    }

    // Post-lesson (and general) feedback — one doc per submission
    // (src/data/feedback.js). Any signed-in user may leave feedback as
    // themselves; only admin/dev can read the list (Admin Dashboard's
    // Feedback panel) or remove entries — nobody can edit one after
    // submitting.
    match /feedback/{feedbackId} {
      allow read, delete: if isAdmin() || isDev();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // VIP Signals stream (src/data/signals.js)
    // Any signed-in user may read the signals feed; only admin/dev can publish
    // or update signal statuses (active -> tp -> sl).
    match /signals/{signalId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'dev'];
      allow write: if isAdmin() || isDev();
    }

    // Push notification broadcast docs (src/services/pushNotificationService.js)
    // Written by admin when a signal is published; read by all authenticated
    // member clients via onSnapshot to trigger browser notifications.
    match /notifications/{notifId} {
      allow read: if request.auth != null &&
        ((get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'dev']) || hasFeature(request.auth.uid, 'vip_signals'));
      allow write: if isAdmin() || isDev();
    }

    // KHQR / Bakong payment requests for subscription plans (src/data/payments.js).
    // Users create requests for their own account in 'pending' status;
    // regular users cannot modify or delete submitted requests.
    // Admins and devs can read all requests and approve/reject or delete them.
    match /paymentRequests/{paymentId} {
      function isValidPaymentRequest() {
        let data = request.resource.data;
        return data.uid == request.auth.uid
          && (data.amount is int || data.amount is float)
          && data.amount > 0
          && data.planId is string
          && data.planId.size() > 0
          && data.planId.size() <= 100
          && data.status == 'pending'
          && (data.createdAt == request.time || (data.createdAt is timestamp && data.createdAt <= request.time));
      }

      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uid || isAdmin() || isDev());
      // Legacy paymentRequests cannot activate subscriptions. All new orders
      // are created and verified by the trusted payment API in /payments.
      allow create, update, delete: if false;
    }
  }
}
